# InsightFace / ArcFace / RetinaFace model files and caches
# (ignore downloaded ONNX / model binaries produced by arcface/retinaface/insightface)
models/*.pt
models/*.pb
models/*.bin
models/*.npy
models/cache/
.insightface/
.insightface_cache/
.cache/insightface/

# If you intentionally track some model files inside `models/`, they will remain tracked.
# These ignore rules only prevent committing newly downloaded large model binaries (e.g., det_10g.onnx, w600k_r50.onnx).

